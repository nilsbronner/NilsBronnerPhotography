---
import { Image } from 'astro:assets';
import { gradientFor } from '@/lib/gradients';
import type { ImageMetadata } from 'astro';

interface Props {
  slug: string;
  client: string;
  year: number;
  summary: string;
  tags: string[];
  aspect?: string;
  thumbnail?: ImageMetadata;
}

const {
  slug,
  client,
  year,
  summary,
  tags,
  aspect = 'aspect-[4/5]',
  thumbnail,
} = Astro.props;

const grad = gradientFor(slug);
---

<a href={`/work/${slug}`} class="group block" data-cursor="VIEW">
  <div
    class={`relative overflow-hidden ${aspect} bg-border`}
    style={thumbnail ? undefined : `background:${grad.background};filter:${grad.filter};`}
  >
    {
      thumbnail && (
        <Image
          src={thumbnail}
          alt={`${client} — projet de Nils Bronner`}
          widths={[480, 800, 1200, 1600]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-[700ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.03]"
          loading="lazy"
          decoding="async"
          quality={82}
        />
      )
    }

    <span
      class="absolute top-4 left-4 text-bg/70 text-xs tracking-[0.25em] uppercase font-sans drop-shadow"
    >
      — Projet
    </span>
    <span
      class="absolute bottom-4 right-4 text-bg/70 text-xs tracking-[0.25em] uppercase font-sans tabular-nums drop-shadow"
    >
      {year}
    </span>

    <div
      class="absolute inset-0 bg-ink/0 group-hover:bg-ink/10 transition-colors duration-500"
    >
    </div>
  </div>

  <div class="mt-5 flex items-baseline justify-between">
    <h3 class="heading-serif text-xl md:text-2xl tracking-tight">
      {client}
    </h3>
    <span class="text-ink-muted text-sm tabular-nums shrink-0 ml-4">↗</span>
  </div>

  <p class="text-ink-muted text-sm mt-1 max-w-md leading-relaxed">{summary}</p>

  <ul class="flex flex-wrap gap-x-3 mt-3 text-[10px] uppercase tracking-[0.18em] text-ink-muted">
    {tags.map((tag) => <li>{tag}</li>)}
  </ul>
</a>

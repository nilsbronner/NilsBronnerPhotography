---
import { Image } from 'astro:assets';
import HorizontalTrack from '@/components/motion/HorizontalTrack';
import type { ImageMetadata } from 'astro';

interface Props {
  images: { src: ImageMetadata; alt: string; label?: string }[];
  chapter?: string;
  title?: string;
}

const { images, chapter, title } = Astro.props;
---

<!-- Tracking shot : section pin verticale, panoramique horizontal -->
{
  (chapter || title) && (
    <div class="container-page pt-32 pb-12 md:pt-40">
      {chapter && (
        <p class="text-[10px] uppercase tracking-[0.3em] text-ink-muted mb-6">
          — {chapter}
        </p>
      )}
      {title && (
        <h2
          class="heading-serif leading-[0.95] tracking-[-0.02em] max-w-[18ch]"
          style="font-size:clamp(2.25rem, 5.5vw, 5rem);"
        >
          {title}
        </h2>
      )}
    </div>
  )
}

<HorizontalTrack client:visible label={title ?? 'Tracking shot'}>
  <div class="flex items-center gap-6 md:gap-10 pl-6 md:pl-12 pr-[20vw]">
    {
      images.map((img, i) => {
        // Ratios alternés pour rythme visuel
        const sizes = [
          { w: '85vh', a: 'aspect-[3/2]' },
          { w: '70vh', a: 'aspect-[4/5]' },
          { w: '90vh', a: 'aspect-[16/9]' },
          { w: '75vh', a: 'aspect-[3/4]' },
          { w: '85vh', a: 'aspect-[5/4]' },
          { w: '70vh', a: 'aspect-[4/5]' },
        ];
        const { w, a } = sizes[i % sizes.length];
        return (
          <figure
            class={`relative shrink-0 ${a} bg-surface overflow-hidden`}
            style={`height:${w}; min-width:300px;`}
          >
            <Image
              src={img.src}
              alt={img.alt}
              widths={[600, 900, 1400, 1800]}
              sizes="60vw"
              quality={84}
              loading="lazy"
              decoding="async"
              class="absolute inset-0 w-full h-full object-cover"
            />
            <span
              class="absolute top-3 left-3 text-ink/80 text-[10px] tracking-[0.3em] uppercase font-sans tabular-nums"
            >
              {String(i + 1).padStart(2, '0')} / {String(images.length).padStart(2, '0')}
            </span>
            {img.label && (
              <span
                class="absolute bottom-3 left-3 text-ink/80 text-[10px] tracking-[0.3em] uppercase font-sans"
              >
                {img.label}
              </span>
            )}
          </figure>
        );
      })
    }
  </div>
</HorizontalTrack>

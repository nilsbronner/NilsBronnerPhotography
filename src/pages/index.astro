---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeIntro from '@/components/motion/HomeIntro';
import HeroParallax from '@/components/motion/HeroParallax';
import KenBurns from '@/components/motion/KenBurns';
import ScrollScale from '@/components/motion/ScrollScale';
import ScrollReveal from '@/components/motion/ScrollReveal';
import ProjectListRow from '@/components/ProjectListRow.astro';
import Cinemascope from '@/components/Cinemascope.astro';
import TrackingShot from '@/components/TrackingShot.astro';
import Marquee from '@/components/Marquee.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

import homeHero from '@/assets/images/home/home-hero.jpg';

// Tracking shot images
import tEvt1 from '@/assets/images/evenementiel/evenementiel-01.jpg';
import tArchi1 from '@/assets/images/architecture/architecture-01.jpg';
import tPort1 from '@/assets/images/portrait/portrait-01.jpg';
import tNuance1 from '@/assets/images/nuance/nuance-01.jpg';
import tBrand1 from '@/assets/images/brand-packshot/brand-packshot-01.jpg';
import tRep1 from '@/assets/images/reportage/reportage-01.jpg';
import tArchi2 from '@/assets/images/architecture/architecture-02.jpg';
import tEvt2 from '@/assets/images/evenementiel/evenementiel-02.jpg';

import cineImage1 from '@/assets/images/reportage/reportage-hero.jpg';
import cineImage2 from '@/assets/images/portrait/portrait-hero.jpg';

const trackingImages = [
  { src: tEvt1, alt: 'Événementiel', label: '[ÉVÉNEMENTIEL]' },
  { src: tArchi1, alt: 'Architecture', label: '[ARCHITECTURE]' },
  { src: tPort1, alt: 'Portrait', label: '[PORTRAIT]' },
  { src: tNuance1, alt: 'nuance', label: '[NUANCE]' },
  { src: tBrand1, alt: 'Brand', label: '[BRAND]' },
  { src: tRep1, alt: 'Reportage', label: '[REPORTAGE]' },
  { src: tArchi2, alt: 'Architecture', label: '[ARCHITECTURE]' },
  { src: tEvt2, alt: 'Événementiel', label: '[ÉVÉNEMENTIEL]' },
];

const projects = (await getCollection('projects'))
  .filter((p) => p.data.locale === 'fr')
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

const clients = [
  'Porsche',
  'GreenGo',
  'Squarea',
  'Hammaecher Sipion',
  'Circuit des Écuyers',
  'Kikk Festival',
  'OPUS 67',
  'EIMI',
  'nuance',
];
---

<BaseLayout
  title="Nils Bronner — Photographe, Strasbourg"
  description="Photographe basé à Strasbourg. Campagnes marques, architecture, portrait éditorial."
  darkHero
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Photograph',
      author: {
        '@type': 'Person',
        name: 'Nils Bronner',
        jobTitle: 'Photographe',
        url: 'https://nilsbronner.com',
      },
    })}
  />

  <!-- ════════════════════════════════════════════════════════════════
       [01] OUVERTURE — hero structurel, all-caps stacked sans-serif
       ════════════════════════════════════════════════════════════════ -->
  <section
    class="relative h-[100svh] min-h-[720px] -mt-16 md:-mt-20 overflow-hidden bg-bg"
  >
    <HeroParallax client:load intensity={60} className="absolute inset-0 w-full h-[110%]">
      <KenBurns client:load duration={40} className="w-full h-full">
        <Image
          src={homeHero}
          alt="Nils Bronner — image hero"
          widths={[1400, 1800, 2200, 2600]}
          sizes="100vw"
          quality={86}
          loading="eager"
          class="w-full h-full object-cover"
        />
      </KenBurns>
    </HeroParallax>

    <!-- Overlay sombre pour contraste texte -->
    <div class="absolute inset-0 bg-gradient-to-b from-bg/40 via-bg/20 to-bg pointer-events-none" />

    <!-- Grain -->
    <div
      class="absolute inset-0 opacity-[0.08] mix-blend-overlay pointer-events-none"
      style="background-image:url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22160%22 height=%22160%22><filter id=%22n%22><feTurbulence baseFrequency=%221.1%22 numOctaves=%222%22 stitchTiles=%22stitch%22/></filter><rect width=%22160%22 height=%22160%22 filter=%22url(%23n)%22/></svg>');"
    >
    </div>

    <!-- HUD top : labels mono en brackets -->
    <div class="absolute top-[8vh] left-0 right-0 container-page flex justify-between text-ink/60 label-mono z-20">
      <span>[SC. 01 · OUVERTURE]</span>
      <span class="hidden md:inline">[STRASBOURG · N48.58° E7.75°]</span>
      <span class="tabular-nums">[00:00 / 06:50]</span>
    </div>

    <!-- TITRE : massive all-caps stacked sans-serif Janis Sne-style -->
    <div class="absolute inset-0 flex items-end pointer-events-none z-20">
      <HomeIntro client:load>
        <div class="container-page pb-[10vh] relative pointer-events-auto">
          <p class="text-ink/60 label-mono mb-8">
            [PHOTOGRAPHE — MARQUES · AGENCES · INSTITUTIONS]
          </p>
          <h1
            class="heading-display text-ink"
            style="font-size:clamp(3.5rem, 14vw, 14rem);"
          >
            <span class="block">L’IMAGE</span>
            <span class="block">QUI</span>
            <span class="block">RESTERA<span class="text-ink/40">.</span></span>
          </h1>
          <div class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-ink/70 label-mono">
            <span>[PRÉCIS]</span>
            <span>[NARRATIF]</span>
            <span>[TENU]</span>
          </div>
        </div>
      </HomeIntro>
    </div>

    <!-- Scrub bar bas -->
    <div class="absolute bottom-[6vh] left-0 right-0 container-page pointer-events-none z-20">
      <div class="flex items-center gap-4 text-ink/50 label-mono">
        <span class="tabular-nums">[SCROLL]</span>
        <span class="flex-1 h-px bg-ink/20 relative">
          <span class="absolute left-0 top-0 h-px w-[14%] bg-ink/70"></span>
        </span>
        <span class="tabular-nums">10/10</span>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════
       [02] POSTURE — texte structurel massif
       ════════════════════════════════════════════════════════════════ -->
  <section class="py-32 md:py-48">
    <div class="container-page">
      <p class="label-mono text-ink-muted mb-10">[SC. 02 / POSTURE]</p>
      <h2
        class="heading-display text-ink leading-[0.85] tracking-[-0.04em] max-w-[18ch]"
        style="font-size:clamp(2.5rem, 8vw, 8rem);"
      >
        Je crois aux images qui tiennent<span class="text-ink/40">.</span>
      </h2>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════
       [03] PLAN LARGE — Cinemascope 2.39:1
       ════════════════════════════════════════════════════════════════ -->
  <ScrollScale client:visible>
    <Cinemascope
      src={cineImage1}
      alt="Plan large"
      scene="[SC. 03 · PLAN LARGE]"
      timecode="[01:23 / 06:50]"
      title="Construire l'image qui restera"
    />
  </ScrollScale>

  <!-- ════════════════════════════════════════════════════════════════
       [04] MANIFESTE — éditorial 2 col
       ════════════════════════════════════════════════════════════════ -->
  <section class="container-page py-32 md:py-40">
    <p class="label-mono text-ink-muted mb-12">[SC. 04 / MANIFESTE]</p>
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-16">
      <ScrollReveal client:visible as="div" className="md:col-span-7">
        <h2
          class="heading-display text-ink leading-[0.9] tracking-[-0.04em]"
          style="font-size:clamp(2rem, 6vw, 5.5rem);"
        >
          Produire moins, produire ce qui restera<span class="text-ink/40">.</span>
        </h2>
      </ScrollReveal>
      <ScrollReveal client:visible as="div" className="md:col-span-5 md:col-start-8 space-y-5 text-ink-muted leading-relaxed text-lg max-w-prose">
        <p>
          Pour ça, il faut du temps, de la lumière et un point de vue. Je travaille
          avec des marques, des agences et des institutions qui partagent cette
          exigence.
        </p>
        <p class="pt-2">
          <a href="/about" class="label-mono text-ink hover:opacity-70 transition-opacity inline-flex items-center gap-2">
            [LIRE LE MANIFESTE COMPLET →]
          </a>
        </p>
      </ScrollReveal>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════
       [05] TRAVELLING — tracking shot pinned, panoramique
       ════════════════════════════════════════════════════════════════ -->
  <TrackingShot
    chapter="[SC. 05 / TRAVELLING]"
    title="Huit plans, une écriture."
    images={trackingImages}
  />

  <!-- ════════════════════════════════════════════════════════════════
       [06] INDEX — projets en stack numéroté Janis Sne-style
       ════════════════════════════════════════════════════════════════ -->
  <section class="container-page py-32 md:py-48">
    <div class="flex items-end justify-between mb-16 md:mb-24">
      <div>
        <p class="label-mono text-ink-muted mb-6">[SC. 06 / INDEX]</p>
        <h2
          class="heading-display text-ink leading-[0.85] tracking-[-0.04em]"
          style="font-size:clamp(2.5rem, 8vw, 7rem);"
        >
          Six univers,<br />une écriture<span class="text-ink/40">.</span>
        </h2>
      </div>
      <a href="/work" class="hidden md:inline-flex label-mono items-center gap-2 hover:opacity-70 transition-opacity">
        [VOIR TOUT →]
      </a>
    </div>

    <ul class="border-b border-border">
      {
        projects.map((project, i) => (
          <li>
            <ProjectListRow
              index={i}
              slug={project.slug}
              client={project.data.client}
              year={project.data.year}
              summary={project.data.summary}
              tags={project.data.tags}
              thumbnail={project.data.thumbnail}
            />
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ════════════════════════════════════════════════════════════════
       [07] PLAN RAPPROCHÉ — Cinemascope 2
       ════════════════════════════════════════════════════════════════ -->
  <ScrollScale client:visible>
    <Cinemascope
      src={cineImage2}
      alt="Plan rapproché"
      scene="[SC. 07 · PLAN RAPPROCHÉ]"
      timecode="[04:35 / 06:50]"
      title="Le regard cadre, hiérarchise, tient la scène"
    />
  </ScrollScale>

  <!-- ════════════════════════════════════════════════════════════════
       [08] CASTING — marquee clients
       ════════════════════════════════════════════════════════════════ -->
  <section class="py-20 md:py-28 border-y border-border">
    <div class="container-page mb-10">
      <p class="label-mono text-ink-muted">[SC. 08 / CASTING]</p>
    </div>
    <Marquee items={clients} duration={70} />
  </section>

  <!-- ════════════════════════════════════════════════════════════════
       [09] GÉNÉRIQUE — CTA final
       ════════════════════════════════════════════════════════════════ -->
  <section class="container-page py-32 md:py-48">
    <p class="label-mono text-ink-muted mb-12">[GÉNÉRIQUE]</p>
    <ScrollReveal client:visible>
      <h2
        class="heading-display text-ink leading-[0.85] tracking-[-0.04em] max-w-[20ch]"
        style="font-size:clamp(2.5rem, 10vw, 9rem);"
      >
        Un projet&nbsp;? Parlons-en<span class="text-ink/40">.</span>
      </h2>
      <div class="mt-12 flex flex-wrap gap-x-6 gap-y-4 label-mono">
        <a href="/contact" class="inline-flex items-center gap-2 hover:opacity-70 transition-opacity">
          [DÉMARRER UN BRIEF →]
        </a>
        <a
          href="mailto:contact@nilsbronner.com"
          class="inline-flex items-center gap-2 text-ink-muted hover:text-ink transition-colors"
        >
          [CONTACT@NILSBRONNER.COM]
        </a>
      </div>
    </ScrollReveal>
  </section>
</BaseLayout>

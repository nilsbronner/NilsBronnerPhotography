---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.locale === 'fr')
  .sort((a, b) => a.data.order - b.data.order);

const aspects = [
  'aspect-[4/5]',
  'aspect-[3/2]',
  'aspect-[3/4]',
  'aspect-[16/11]',
  'aspect-[4/5]',
  'aspect-[5/7]',
  'aspect-[3/2]',
  'aspect-[4/5]',
];

const layouts = [
  'md:col-span-7',
  'md:col-span-5 md:mt-40',
  'md:col-span-5',
  'md:col-span-7 md:mt-40',
  'md:col-span-6',
  'md:col-span-6 md:mt-40',
  'md:col-span-7',
  'md:col-span-5 md:mt-40',
];
---

<BaseLayout
  title="Work — Nils Bronner"
  description="Portfolio complet — architecture, événementiel, brand, portrait, reportage, nuance."
>
  <section class="container-page pt-32 md:pt-48 pb-16">
    <p class="text-[10px] uppercase tracking-[0.3em] text-ink-muted mb-6">
      — Portfolio · Sélection 2023 – 2025
    </p>
    <h1
      class="heading-serif leading-[0.95] tracking-[-0.02em] max-w-[18ch]"
      style="font-size:clamp(3rem, 9vw, 8rem);"
    >
      Le travail, <span class="italic font-light">par univers.</span>
    </h1>
    <p class="mt-10 text-ink-muted text-lg max-w-prose leading-relaxed">
      Six terrains où je reviens régulièrement. Chaque univers se nourrit des
      autres — le portrait infuse le reportage, l’architecture cadre
      l’événementiel.
    </p>
  </section>

  <section class="container-page pb-32 md:pb-48">
    <ul class="grid grid-cols-1 md:grid-cols-12 gap-x-6 md:gap-x-8 gap-y-20 md:gap-y-32">
      {
        projects.map((project, i) => (
          <li class={layouts[i] ?? 'md:col-span-6'}>
            <ProjectCard
              slug={project.slug}
              client={project.data.client}
              year={project.data.year}
              summary={project.data.summary}
              tags={project.data.tags}
              aspect={aspects[i] ?? 'aspect-[4/5]'}
              thumbnail={project.data.thumbnail}
            />
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

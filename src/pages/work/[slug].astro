---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { gradientFor } from '@/lib/gradients';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects');
  return projects
    .filter((p) => p.data.locale === 'fr')
    .map((project) => ({
      params: { slug: project.slug },
      props: { project },
    }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await project.render();
const { data, slug } = project;

const all = (await getCollection('projects'))
  .filter((p) => p.data.locale === 'fr')
  .sort((a, b) => a.data.order - b.data.order);
const idx = all.findIndex((p) => p.slug === slug);
const prev = idx > 0 ? all[idx - 1] : all[all.length - 1];
const next = idx < all.length - 1 ? all[idx + 1] : all[0];

const grad = gradientFor(slug);
---

<BaseLayout title={`${data.client} — Nils Bronner`} description={data.summary} darkHero>
  <article>
    <!-- Hero plein écran — image projet (fallback gradient si absente) -->
    <section
      class="relative h-[88vh] min-h-[600px] -mt-16 md:-mt-20 flex items-end overflow-hidden bg-ink"
      style={data.heroImage ? undefined : `background:${grad.background};filter:${grad.filter};`}
    >
      {
        data.heroImage && (
          <Image
            src={data.heroImage}
            alt={`${data.client} — image hero`}
            widths={[800, 1200, 1600, 2000, 2400]}
            sizes="100vw"
            quality={85}
            loading="eager"
            class="absolute inset-0 w-full h-full object-cover opacity-[0.85]"
          />
        )
      }
      <div
        class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/40 to-ink/20 pointer-events-none"
      >
      </div>

      <div class="absolute top-24 md:top-28 left-0 right-0 container-page flex justify-between text-bg/70 text-[11px] uppercase tracking-[0.25em] font-sans">
        <span>{data.role}</span>
        <span class="tabular-nums">{data.year}</span>
      </div>

      <div class="container-page pb-16 md:pb-20 relative">
        <p class="text-bg/70 text-[11px] uppercase tracking-[0.3em] mb-6">
          — Case study
        </p>
        <h1
          class="font-serif text-bg leading-[0.95] tracking-[-0.02em] max-w-[14ch]"
          style="font-size:clamp(2.5rem, 8vw, 7rem);"
        >
          {data.client}
        </h1>
      </div>
    </section>

    <!-- Texte + métadonnées -->
    <section class="container-page py-24 md:py-40 grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-16">
      <aside class="md:col-span-3 md:sticky md:top-28 self-start text-sm space-y-6">
        <dl class="space-y-4">
          <div>
            <dt class="text-[10px] uppercase tracking-[0.25em] text-ink-muted">Client</dt>
            <dd class="heading-serif text-lg mt-1">{data.client}</dd>
          </div>
          <div>
            <dt class="text-[10px] uppercase tracking-[0.25em] text-ink-muted">Année</dt>
            <dd class="tabular-nums mt-1">{data.year}</dd>
          </div>
          <div>
            <dt class="text-[10px] uppercase tracking-[0.25em] text-ink-muted">Rôle</dt>
            <dd class="mt-1">{data.role}</dd>
          </div>
          {
            data.deliverables.length > 0 && (
              <div>
                <dt class="text-[10px] uppercase tracking-[0.25em] text-ink-muted">Livrables</dt>
                <dd class="mt-1">
                  <ul class="space-y-1">
                    {data.deliverables.map((d) => (
                      <li>{d}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            )
          }
        </dl>
      </aside>

      <div class="md:col-span-8 md:col-start-5 max-w-prose">
        <p class="heading-serif text-2xl md:text-3xl leading-tight mb-10 text-ink">
          {data.summary}
        </p>
        <div class="prose prose-neutral max-w-none text-lg leading-relaxed text-ink-muted">
          <Content />
        </div>
      </div>
    </section>

    <!-- Navigation projet précédent / suivant -->
    <nav class="container-page py-24 md:py-32 border-t border-border grid grid-cols-2 gap-8">
      <a href={`/work/${prev.slug}`} class="group">
        <p class="text-[10px] uppercase tracking-[0.25em] text-ink-muted mb-2">
          ← Précédent
        </p>
        <p class="heading-serif text-2xl md:text-3xl group-hover:text-ink-muted transition-colors">
          {prev.data.client}
        </p>
      </a>
      <a href={`/work/${next.slug}`} class="group text-right">
        <p class="text-[10px] uppercase tracking-[0.25em] text-ink-muted mb-2">
          Suivant →
        </p>
        <p class="heading-serif text-2xl md:text-3xl group-hover:text-ink-muted transition-colors">
          {next.data.client}
        </p>
      </a>
    </nav>
  </article>
</BaseLayout>

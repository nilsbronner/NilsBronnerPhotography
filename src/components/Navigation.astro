---
import MobileMenu from '@/components/motion/MobileMenu';
import { t, localizedPath, type Locale } from '@/lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const navItems = [
  { href: localizedPath(locale, '/work'), label: t(locale, 'nav.work') },
  { href: localizedPath(locale, '/about'), label: t(locale, 'nav.about') },
  { href: localizedPath(locale, '/services'), label: t(locale, 'nav.services') },
  { href: localizedPath(locale, '/contact'), label: t(locale, 'nav.contact') },
];

const homeHref = localizedPath(locale, '/');
---

<header
  id="site-nav"
  class="fixed top-0 left-0 right-0 z-40 transition-[background,border-color,backdrop-filter] duration-500 border-b border-transparent text-ink"
  data-nav-state="top"
>
  <div class="container-page flex items-center justify-between h-16 md:h-20">
    <a
      href={homeHref}
      class="flex items-baseline gap-2 group"
      aria-label="Accueil"
    >
      <span class="heading-serif text-lg md:text-xl tracking-tight">
        Nils Bronner
      </span>
      <span class="hidden sm:inline text-[10px] uppercase tracking-[0.25em] opacity-60">
        — Photographe
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-10 text-sm">
      {
        navItems.map((item, i) => (
          <a
            href={item.href}
            class="relative hover:opacity-60 transition-opacity duration-300"
          >
            <span class="text-[10px] tabular-nums opacity-40 mr-1.5">
              0{i + 1}
            </span>
            {item.label}
          </a>
        ))
      }
    </nav>

    <MobileMenu
      client:idle
      items={navItems}
      openLabel={t(locale, 'nav.menu.open')}
      closeLabel={t(locale, 'nav.menu.close')}
    />
  </div>
</header>

<script>
  // Toggle texte clair (top, sur hero sombre) → texte foncé (scrolled, sur bg clair).
  // Évite Motion, c'est du chrome — Tailwind + CSS pur suffit.
  // En dark mode, le texte reste toujours clair (text-ink).
  // Seul le backdrop change : transparent en top, blur sur scroll.
  const nav = document.getElementById('site-nav');
  if (nav) {
    const update = () => {
      const scrolled = window.scrollY > 80;
      if (scrolled) {
        nav.classList.add('bg-bg/80', 'backdrop-blur-xl', 'border-border');
        nav.classList.remove('border-transparent');
        nav.dataset.navState = 'scrolled';
      } else {
        nav.classList.remove('bg-bg/80', 'backdrop-blur-xl', 'border-border');
        nav.classList.add('border-transparent');
        nav.dataset.navState = 'top';
      }
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
